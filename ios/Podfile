# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip
platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

pod 'NetmeraNotificationServiceExtension', "4.23.1"
pod "NetmeraNotificationContentExtension", "4.23.1"

use_frameworks! :linkage => :dynamic

target 'NetmeraTSExample' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  pre_install do |installer|
    installer.pod_targets.each do |pod|
      # RNDeviceInfo only declares a React-Core dependency and doesn't link
      # React-Core-prebuilt directly, so as a dynamic framework it can't
      # resolve RCTEventEmitter/RCTRegisterModule at link time. Building it
      # as a static framework merges those symbols in at the app link step.
      if pod.name == 'RNDeviceInfo'
        def pod.build_type
          Pod::BuildType.static_framework
        end
      end
    end
  end

  post_install do |installer|
      react_native_post_install(
        installer,
        config[:reactNativePath],
        :mac_catalyst_enabled => false,
        # :ccache_enabled => true
      )
      installer.pods_project.targets.each do |target|
        # For Netmera
        if target.name.include?('Swinject')
          target.build_configurations.each do |config|
            config.build_settings['BUILD_LIBRARY_FOR_DISTRIBUTION'] = 'YES'
          end
        end
        target.build_configurations.each do |config|
          config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.1'
        end
      end
   end
end

target 'Netmera_NotificationServiceExtension' do
end

target 'Netmera_NotificationContentExtension' do
end
